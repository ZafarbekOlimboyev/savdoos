name: CI

# Har push va PR'da avtomatik: backend testlari + frontend tip tekshiruvi.
# Regressiyani (masalan kirim buzilishi, imtiyoz-oshirish) merge'dan oldin ushlaydi.

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  backend:
    name: Backend (pytest)
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: apps/server
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - name: Install
        run: |
          python -m pip install --upgrade pip
          pip install -e .
          pip install pytest
      - name: Run tests
        run: pytest -q

  frontend:
    name: Frontend (tsc)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: "20"
      - name: Install deps
        run: npm install --no-audit --no-fund
      - name: Type-check Manager
        run: cd apps/manager && npx tsc --noEmit
      - name: Type-check POS
        run: cd apps/pos && npx tsc --noEmit
