# === Ma'lumotlar bazasi ===
# Standart: SQLite (demo — hech narsa o'rnatilmaydi). Fayl: apps/server/savdoos.db
DATABASE_URL=sqlite:///./savdoos.db
# Production (Postgres) — quyidagini yoqing (Docker: infra/docker-compose.yml):
# DATABASE_URL=postgresql+psycopg://savdoos:savdoos@localhost:5432/savdoos

# JWT
SECRET_KEY=dev-secret-change-me
ACCESS_TOKEN_MINUTES=720
REFRESH_TOKEN_DAYS=30

# CORS — "*" paketlangan desktop ilova (file://) va dev server, ikkalasi ham ulanadi.
CORS_ORIGINS=*

REDIS_URL=redis://localhost:6379/0
