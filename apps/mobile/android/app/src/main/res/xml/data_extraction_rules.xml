<?xml version="1.0" encoding="utf-8"?>
<!--
  Zaxira/ko'chirishда do'kon ma'lumoti (kesh katalog — tannarx/margin, xodim profili)
  qurilmadan tashqariga chiqmasin. Barcha ma'lumot serverda — qurilmada saqlash faqat kesh.
  allowBackup="false" bilan birga cloud/adb zaxira o'chiriladi; bu qoidalar Android 12+ da
  qurilmadan-qurilmaga ko'chirishни ham to'sadi.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
