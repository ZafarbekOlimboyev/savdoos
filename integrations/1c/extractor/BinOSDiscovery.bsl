// BinOS Discovery Collector — 1C tashqi qayta ishlash MODULI (ObjectModule).
//
// ⚠️⚠️  RUNTIME'DA SINALMAGAN.  Bu manba 1C:Enterprise platformasi BO'LMAGAN mashinada yozilgan.
//       U kompilyatsiya QILINMAGAN, sintaksis tekshiruvidan O'TMAGAN va hech qanday 1C bazasida
//       ISHLATILMAGAN. Ishlatishdan oldin mijozning 1C mutaxassisi Konfiguratorda ochib
//       sintaksisni tekshirishi SHART. «Ishlaydi» degan da'vo YO'Q.
//
// ⚠️⚠️  FAQAT AJRATILGAN NUSXADA.  Bu qayta ishlash HECH QACHON jonli bazada ochilmaydi.
//       Nusxa alohida (do'kon LAN'idagi zaxira) kompyuterga tiklanadi va u yerda ishlatiladi.
//
// NIMA QILADI:   konfiguratsiya METADATASINI o'qiydi, obyektlar sonini sanaydi va discovery
//                to'plamini (`binos-1c-discovery-v1`) JSON fayl sifatida yozadi.
// NIMA QILMAYDI: hech narsa yozmaydi, o'tkazmaydi, o'chirmaydi, monopol rejim olmaydi,
//                tranzaksiya ochmaydi, tarozi bilan almashmaydi, biznes ma'lumotini
//                (narx, mijoz, hujjat qatori) chiqarmaydi.
//
// TAQIQLANGAN CHAQIRUVLAR statik audit bilan MAJBURLANADI:
// `apps/server/app/services/discovery_1c/epf_audit.py` + `tests/test_discovery_1c_epf_source.py`.
// Ro'yxat hujjat emas — DARVOZA: audit CI'da ishlaydi va manba buzilsa to'plam qizil bo'ladi.
//
// MA'LUMOTNI MINIMALLASHTIRISH: standart rejim `ТолькоМетаданные = Истина`. Unda qiymatlar
// UMUMAN o'qilmaydi — faqat metadata va КОЛИЧЕСТВО(*). Namuna qiymatlar bu versiyada
// UMUMAN olinmaydi.

#Область ПеременныеМодуля

Перем ЖурналОшибок;      // Массив — yiqilgan bo'lim JIMGINA tushirilmaydi
Перем ВерсияСхемы;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Asosiy kirish nuqtasi. `КаталогВыгрузки` — operator ko'rsatgan BO'SH papka.
// `ТолькоМетаданные` = Истина -> qiymatlar o'qilmaydi (STANDART va yagona qo'llab-quvvatlanadigan).
Функция ВыполнитьРазведку(КаталогВыгрузки, Знач ТолькоМетаданные = Истина) Экспорт

	ЖурналОшибок = Новый Массив;
	ВерсияСхемы = "binos-1c-discovery-v1";

	Результат = Новый Структура;
	Результат.Вставить("schema_version", ВерсияСхемы);
	Результат.Вставить("collector_version", "0.1.0-UNVERIFIED");
	Результат.Вставить("metadata_only", ?(ТолькоМетаданные, "true", "false"));
	Результат.Вставить("platform", СобратьПлатформу());
	Результат.Вставить("metadata_sweep", СобратьМетаданные());
	Результат.Вставить("counts", СобратьСчетчики());
	Результат.Вставить("targets", СобратьКандидатов());
	Результат.Вставить("errors", ЖурналОшибок);
	Результат.Вставить("status", ?(ЖурналОшибок.Количество() = 0, "COMPLETE", "PARTIAL"));

	ЗаписатьРезультат(КаталогВыгрузки, Результат);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедуры

// ── 1. PLATFORMA VA KONFIGURATSIYA ────────────────────────────────────────────────────────
Функция СобратьПлатформу()

	Сведения = Новый Структура;

	Попытка
		СистемнаяИнфо = Новый СистемнаяИнформация;
		Сведения.Вставить("platform_version", СистемнаяИнфо.ВерсияПриложения);
	Исключение
		ДобавитьОшибку("platform_version", ОписаниеОшибки());
	КонецПопытки;

	Попытка
		Сведения.Вставить("config_name", Метаданные.Имя);
		Сведения.Вставить("config_synonym", Метаданные.Синоним);
		Сведения.Вставить("config_version", Метаданные.Версия);
		Сведения.Вставить("config_vendor", Метаданные.Поставщик);
		// ⚠️ Konfiguratsiya NOMI moslashuvi — KUCHSIZ dalil (`name_match`). U konfiguratsiya
		//    aynan o'sha tipovoy yechim ekanini ISBOTLAMAYDI: o'zgartirilgan bazada nom bir xil,
		//    mazmun boshqa bo'lishi mumkin. Shu bois ishonch darajasi CANDIDATE bo'lib qoladi.
		Сведения.Вставить("config_name_evidence", "name_match");
	Исключение
		ДобавитьОшибку("configuration", ОписаниеОшибки());
	КонецПопытки;

	Возврат Сведения;

КонецФункции

// ── 2. METADATA SWEEP ─────────────────────────────────────────────────────────────────────
Функция СобратьМетаданные()

	Свод = Новый Структура;
	Свод.Вставить("catalogs", ОписатьКоллекцию(Метаданные.Справочники, "catalog"));
	Свод.Вставить("documents", ОписатьКоллекцию(Метаданные.Документы, "document"));
	Свод.Вставить("information_registers",
		ОписатьКоллекцию(Метаданные.РегистрыСведений, "information_register"));
	Свод.Вставить("accumulation_registers",
		ОписатьКоллекцию(Метаданные.РегистрыНакопления, "accumulation_register"));
	Свод.Вставить("chart_of_characteristic_types",
		ОписатьКоллекцию(Метаданные.ПланыВидовХарактеристик, "chart_of_characteristic_types"));
	Свод.Вставить("enums", ОписатьКоллекцию(Метаданные.Перечисления, "enum"));
	Свод.Вставить("constants", ОписатьКоллекцию(Метаданные.Константы, "constant"));
	Возврат Свод;

КонецФункции

Функция ОписатьКоллекцию(Коллекция, ВидИсточника)

	Список = Новый Массив;
	Для Каждого ОбъектМД Из Коллекция Цикл
		Попытка
			Элемент = Новый Структура;
			Элемент.Вставить("name", ОбъектМД.Имя);
			Элемент.Вставить("synonym", ОбъектМД.Синоним);
			Элемент.Вставить("source_kind", ВидИсточника);
			Элемент.Вставить("attributes", ОписатьРеквизиты(ОбъектМД));
			Элемент.Вставить("tabular_sections", ОписатьТабличныеЧасти(ОбъектМД));
			Элемент.Вставить("dimensions", ОписатьКоллекциюПоля(ОбъектМД, "Измерения"));
			Элемент.Вставить("resources", ОписатьКоллекциюПоля(ОбъектМД, "Ресурсы"));
			Список.Добавить(Элемент);
		Исключение
			ДобавитьОшибку(ВидИсточника + ":" + ОбъектМД.Имя, ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
	Возврат Список;

КонецФункции

Функция ОписатьРеквизиты(ОбъектМД)

	Список = Новый Массив;
	Попытка
		Для Каждого Реквизит Из ОбъектМД.Реквизиты Цикл
			Сведения = Новый Структура;
			Сведения.Вставить("name", Реквизит.Имя);
			Сведения.Вставить("synonym", Реквизит.Синоним);
			Сведения.Вставить("type", ОписатьТип(Реквизит.Тип));
			Список.Добавить(Сведения);
		КонецЦикла;
	Исключение
		// Bu obyekt turida `Реквизиты` kolleksiyasi yo'q — shakl farqi, xato emas.
	КонецПопытки;
	Возврат Список;

КонецФункции

Функция ОписатьКоллекциюПоля(ОбъектМД, ИмяКоллекции)

	Список = Новый Массив;
	Попытка
		Коллекция = ОбъектМД[ИмяКоллекции];
		Для Каждого Поле Из Коллекция Цикл
			Сведения = Новый Структура;
			Сведения.Вставить("name", Поле.Имя);
			Сведения.Вставить("synonym", Поле.Синоним);
			Сведения.Вставить("type", ОписатьТип(Поле.Тип));
			Список.Добавить(Сведения);
		КонецЦикла;
	Исключение
		// Bu obyekt turida bunday kolleksiya yo'q.
	КонецПопытки;
	Возврат Список;

КонецФункции

Функция ОписатьТабличныеЧасти(ОбъектМД)

	Список = Новый Массив;
	Попытка
		Для Каждого ТабличнаяЧасть Из ОбъектМД.ТабличныеЧасти Цикл
			Сведения = Новый Структура;
			Сведения.Вставить("name", ТабличнаяЧасть.Имя);
			Сведения.Вставить("attributes", ОписатьРеквизиты(ТабличнаяЧасть));
			Список.Добавить(Сведения);
		КонецЦикла;
	Исключение
		// Табличные части yo'q.
	КонецПопытки;
	Возврат Список;

КонецФункции

// Tip TAVSIFI — qiymat EMAS. Razryadlik muhim: qoldiq 3 kasr xonalimi, narx 2 mi?
Функция ОписатьТип(ОписаниеТипаЗначения)

	Результат = Новый Структура;
	СписокТипов = Новый Массив;
	Попытка
		Для Каждого Тип Из ОписаниеТипаЗначения.Типы() Цикл
			СписокТипов.Добавить(Строка(Тип));
		КонецЦикла;
		Результат.Вставить("types", СписокТипов);

		КвалификаторыЧисла = ОписаниеТипаЗначения.КвалификаторыЧисла;
		Если КвалификаторыЧисла <> Неопределено Тогда
			Результат.Вставить("digits", Формат(КвалификаторыЧисла.Разрядность, "ЧГ=0"));
			Результат.Вставить("fraction_digits",
				Формат(КвалификаторыЧисла.РазрядностьДробнойЧасти, "ЧГ=0"));
		КонецЕсли;

		КвалификаторыСтроки = ОписаниеТипаЗначения.КвалификаторыСтроки;
		Если КвалификаторыСтроки <> Неопределено Тогда
			Результат.Вставить("length", Формат(КвалификаторыСтроки.Длина, "ЧГ=0"));
		КонецЕсли;
	Исключение
		ДобавитьОшибку("type_description", ОписаниеОшибки());
	КонецПопытки;
	Возврат Результат;

КонецФункции

// ── 3. SANOQLAR — FAQAT КОЛИЧЕСТВО(*) ─────────────────────────────────────────────────────
// ⚠️ Birorta QATOR chiqmaydi. Bu — hajm baholash uchun, ma'lumot ko'chirish uchun emas.
Функция СобратьСчетчики()

	Счетчики = Новый Структура;

	Для Каждого Справочник Из Метаданные.Справочники Цикл
		Попытка
			Счетчики.Вставить("Справочник_" + Справочник.Имя,
				ПолучитьСчетчик("Справочник." + Справочник.Имя));
		Исключение
			ДобавитьОшибку("count:Справочник." + Справочник.Имя, ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

	Для Каждого Регистр Из Метаданные.РегистрыСведений Цикл
		Попытка
			Счетчики.Вставить("РегистрСведений_" + Регистр.Имя,
				ПолучитьСчетчик("РегистрСведений." + Регистр.Имя));
		Исключение
			ДобавитьОшибку("count:РегистрСведений." + Регистр.Имя, ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

	Возврат Счетчики;

КонецФункции

// Sanoq MATN sifatida qaytariladi — JSON SONI TAQIQLANGAN (oldingi nollar yo'qoladi).
Функция ПолучитьСчетчик(ПолноеИмя)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Кол ИЗ " + ПолноеИмя;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Формат(Выборка.Кол, "ЧГ=0");
	КонецЕсли;
	Возврат "0";

КонецФункции

// ── 4. NISHON NOMZODLARI — HAMMASI CANDIDATE ──────────────────────────────────────────────
// ⚠️ Bu bo'lim HECH QACHON eng yuqori ishonch darajasini bermaydi. U faqat nom mosligini
//    topadi, bu esa `schema.py` bo'yicha KUCHSIZ dalil. Yuqori daraja faqat odam tasdig'i,
//    arifmetik isbot yoki mustaqil manbalar kelishuvi bilan — ya'ni BinOS TOMONIDA beriladi.
Функция СобратьКандидатов()

	Кандидаты = Новый Массив;
	Кандидаты.Добавить(ПостроитьКандидата("products.guid", "Справочник", "Номенклатура"));
	Кандидаты.Добавить(ПостроитьКандидата("products.barcodes", "РегистрСведений", "Штрихкоды"));
	Кандидаты.Добавить(ПостроитьКандидата("products.stock", "РегистрНакопления", "ТоварыНаСкладах"));
	Кандидаты.Добавить(ПостроитьКандидата("price_types", "Справочник", "ВидыЦен"));
	Кандидаты.Добавить(ПостроитьКандидата("warehouses", "Справочник", "Склады"));
	Возврат Кандидаты;

КонецФункции

Функция ПостроитьКандидата(Цель, ВидПрефикс, ОжидаемоеИмя)

	Результат = Новый Структура;
	ВидыДоказательств = Новый Массив;
	Найдено = Ложь;

	Попытка
		Если ВидПрефикс = "Справочник" Тогда
			Найдено = (Метаданные.Справочники.Найти(ОжидаемоеИмя) <> Неопределено);
		ИначеЕсли ВидПрефикс = "РегистрСведений" Тогда
			Найдено = (Метаданные.РегистрыСведений.Найти(ОжидаемоеИмя) <> Неопределено);
		ИначеЕсли ВидПрефикс = "РегистрНакопления" Тогда
			Найдено = (Метаданные.РегистрыНакопления.Найти(ОжидаемоеИмя) <> Неопределено);
		КонецЕсли;
	Исключение
		ДобавитьОшибку("candidate:" + Цель, ОписаниеОшибки());
	КонецПопытки;

	Результат.Вставить("target", Цель);
	Если Найдено Тогда
		ВидыДоказательств.Добавить("name_match");
		Результат.Вставить("source_kind", НижнийРегистрВида(ВидПрефикс));
		Результат.Вставить("found_name", ОжидаемоеИмя);
	Иначе
		// Yo'qlik ham TO'LIQ javob — lekin u ham dalil talab qiladi.
		ВидыДоказательств.Добавить("absence_proven");
		Результат.Вставить("source_kind", "absent");
	КонецЕсли;
	Результат.Вставить("confidence", "CANDIDATE");
	Результат.Вставить("evidence_kinds", ВидыДоказательств);
	Возврат Результат;

КонецФункции

Функция НижнийРегистрВида(ВидПрефикс)

	Если ВидПрефикс = "Справочник" Тогда
		Возврат "catalog";
	ИначеЕсли ВидПрефикс = "РегистрСведений" Тогда
		Возврат "information_register";
	ИначеЕсли ВидПрефикс = "РегистрНакопления" Тогда
		Возврат "accumulation_register";
	КонецЕсли;
	Возврат "computed";

КонецФункции

// ── 5. YOZISH ─────────────────────────────────────────────────────────────────────────────
Процедура ЗаписатьРезультат(КаталогВыгрузки, Результат)

	Попытка
		ПараметрыJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, "  ");
		ПотокJSON = Новый ЗаписьJSON;
		ПотокJSON.ОткрытьФайл(КаталогВыгрузки + "/discovery.json", "UTF-8", Ложь, ПараметрыJSON);
		ЗаписатьJSON(ПотокJSON, Результат);
		ПотокJSON.Закрыть();
	Исключение
		ДобавитьОшибку("write:discovery.json", ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

Процедура ДобавитьОшибку(Раздел, Описание)

	Ошибка = Новый Структура;
	Ошибка.Вставить("section", Раздел);
	Ошибка.Вставить("error", Описание);
	ЖурналОшибок.Добавить(Ошибка);      // JIMGINA tushirilmaydi — to'plamda qoladi

КонецПроцедуры

#КонецОбласти
