{
  "name": "savdoos-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "SavdoOS — POS va Manager desktop ilovalari (umumiy kod: packages/shared)",
  "scripts": {
    "dev:pos": "cd apps/pos && npm run dev",
    "dev:manager": "cd apps/manager && npm run dev",
    "dist:pos": "cd apps/pos && npm run dist",
    "dist:manager": "cd apps/manager && npm run dist",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
